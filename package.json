{
  "name": "artesanos-online",
  "version": "2.0.0",
  "private": true,
  "description": "Tienda de artesanía: frontend y admin en Vercel, backend en Cloudflare Workers",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "deploy:backend": "pnpm --filter backend deploy",
    "seed": "pnpm --filter backend seed"
  },
  "license": "ISC"
}
